            &lt;/tps:color&gt;
        &lt;/tps:charStyleDef&gt;
    &lt;/tps:definition&gt;
    &lt;tps:definition tag="charStyleDef"&gt;
        &lt;tps:charStyleDef&gt;
            &lt;tps:name&gt;fig.label&lt;/tps:name&gt;
            &lt;tps:basedOn&gt;TableTitle&lt;/tps:basedOn&gt;
            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;
            &lt;tps:color&gt;
                NEJM Red
            &lt;/tps:color&gt;
        &lt;/tps:charStyleDef&gt;
    &lt;/tps:definition&gt;
    &lt;tps:definition tag="charStyleDef"&gt;
        &lt;tps:charStyleDef&gt;
            &lt;tps:name&gt;fig.serif&lt;/tps:name&gt;
            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;
            &lt;tps:font&gt;
                &lt;tps:name&gt;OTNEJMQuadraat&lt;/tps:name&gt;
                &lt;tps:style&gt;Regular&lt;/tps:style&gt;
            &lt;/tps:font&gt;
            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;
        &lt;/tps:charStyleDef&gt;
    &lt;/tps:definition&gt;
    &lt;tps:definition tag="charStyleDef"&gt;
        &lt;tps:charStyleDef&gt;
            &lt;tps:name&gt;head2.italic&lt;/tps:name&gt;
            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;
            &lt;tps:font&gt;
                &lt;tps:name&gt;OTNEJMScalaSansSmallLFCap&lt;/tps:name&gt;
                &lt;tps:style&gt;Bold Italic&lt;/tps:style&gt;
            &lt;/tps:font&gt;
            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;
        &lt;/tps:charStyleDef&gt;
