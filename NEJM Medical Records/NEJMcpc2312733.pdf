        &lt;tps:charStyleDef&gt;
            &lt;tps:name&gt;CorrRunIn&lt;/tps:name&gt;
            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;
            &lt;tps:font&gt;
                &lt;tps:name&gt;OTNEJMScalaSansSmallLFCap&lt;/tps:name&gt;
                &lt;tps:style&gt;Bold&lt;/tps:style&gt;
            &lt;/tps:font&gt;
            &lt;tps:fontSize&gt;10 pt&lt;/tps:fontSize&gt;
            &lt;tps:leading&gt;12 pt&lt;/tps:leading&gt;
            &lt;tps:color&gt;
                NEJM Red
            &lt;/tps:color&gt;
            &lt;tps:case&gt;normal&lt;/tps:case&gt;
        &lt;/tps:charStyleDef&gt;
    &lt;/tps:definition&gt;
    &lt;tps:definition tag="charStyleDef"&gt;
        &lt;tps:charStyleDef&gt;
            &lt;tps:name&gt;Default&lt;/tps:name&gt;
            &lt;tps:basedOn&gt;*&lt;/tps:basedOn&gt;
