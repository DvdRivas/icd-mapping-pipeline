            &lt;/tps:color&gt;
        &lt;/tps:charStyleDef&gt;
    &lt;/tps:definition&gt;
    &lt;tps:definition tag="charStyleDef"&gt;
        &lt;tps:charStyleDef&gt;
            &lt;tps:name&gt;fig.label&lt;/tps:name&gt;
            &lt;tps:basedOn&gt;TableTitle&lt;/tps:basedOn&gt;
            &lt;tps:leading&gt;0 pt&lt;/tps:leading&gt;
            &lt;tps:color&gt;
                NEJM Red
            &lt;/tps:color&gt;
