        &lt;tps:sectionDef toc="false" type="mainStory" repeating="true"&gt;
            &lt;tps:name&gt;OA_first&lt;/tps:name&gt;
            &lt;tps:masterSpreads&gt;
                &lt;tps:masterSpread&gt;
